<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.org only. Electrified.TimeSeries is published there (1.1.0), so a standalone build
    (package mode; see Directory.Build.props) restores it on any machine. <clear/> keeps
    user-level feeds from changing what this repository resolves.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
