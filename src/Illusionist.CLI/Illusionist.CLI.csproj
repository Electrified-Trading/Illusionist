<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Illusionist.Core\Illusionist.Core.csproj" />
  </ItemGroup>

  <!-- Same sibling/package split as Illusionist.Core.csproj (see Directory.Build.props):
       explicit here too, not relying on transitivity through Illusionist.Core, since a
       standalone build has no sibling for either project to transit. -->
  <ItemGroup Condition="'$(IllusionistUsePackageReferences)' != 'true'">
    <ProjectReference Include="$(IllusionistElectrifiedTimeSeriesSiblingPath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(IllusionistUsePackageReferences)' == 'true'">
    <PackageReference Include="Electrified.TimeSeries" />
  </ItemGroup>

</Project>
